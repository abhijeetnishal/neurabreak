<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Camera access — required for posture and presence detection -->
    <key>com.apple.security.device.camera</key>
    <true/>

    <!--
        The four entitlements below are required by PyInstaller + Python native
        extensions (onnxruntime, opencv, sounddevice) under the hardened runtime
        (--options runtime). Without them, Gatekeeper rejects the app at launch.
    -->

    <!-- Python JIT / ctypes / CFFI need executable writable memory -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- onnxruntime and other native extensions map unsigned executable pages -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- PyInstaller injects DYLD_INSERT_LIBRARIES / DYLD_LIBRARY_PATH at startup -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>

    <!-- Bundled dylibs (opencv, soundfile, etc.) are not individually signed -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
